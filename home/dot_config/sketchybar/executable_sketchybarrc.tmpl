{{- $palette := include "../themes/catppuccin-contrast.toml" | fromToml -}}
{{- $colors := index $palette "colors" -}}
{{- $base := index $colors "base" | trimPrefix "#" -}}
{{- $crust := index $colors "crust" | trimPrefix "#" -}}
{{- $surface0 := index $colors "surface0" | trimPrefix "#" -}}
{{- $surface1 := index $colors "surface1" | trimPrefix "#" -}}
{{- $lavender := index $colors "lavender" | trimPrefix "#" -}}
{{- $subtext1 := index $colors "subtext1" | trimPrefix "#" -}}
{{- $text := index $colors "text" | trimPrefix "#" -}}
#!/usr/bin/env bash

# showy-quota requires Bash 4+; macOS /bin/bash is 3.2.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
if (( BASH_VERSINFO[0] < 4 )); then
    brew_bash=$(command -v bash)
    if [[ "$brew_bash" == /bin/bash || "$brew_bash" == /usr/bin/bash ]]; then
        echo "SketchyBar requires Homebrew bash (brew install bash)" >&2
        exit 1
    fi
    exec "$brew_bash" "$0" "$@"
fi
set -euo pipefail

PLUGIN_DIR="$CONFIG_DIR/plugins"
export HYPRSPACE_BIN

if [ -n "${HYPRSPACE_BIN:-}" ]; then
	HYPRSPACE_BIN="$HYPRSPACE_BIN"
elif command -v brew >/dev/null 2>&1; then
	HYPRSPACE_BIN="$(brew --prefix)/bin/hyprspace"
elif [ "$(uname -m)" = "arm64" ]; then
	HYPRSPACE_BIN="/opt/homebrew/bin/hyprspace"
else
	HYPRSPACE_BIN="/usr/local/bin/hyprspace"
fi

if [ ! -x "$HYPRSPACE_BIN" ]; then
	HYPRSPACE_BIN="$(command -v hyprspace 2>/dev/null || true)"
fi

# Catppuccin Waybar supplies palette tokens, not layout rules. This keeps its
# Base/Text roles while using the repository's Contrast palette.
# Float above application windows; sketchybar-toggle yields the top edge.
sketchybar --bar topmost=window height=40 color=0xff{{ $base }} border_width=2 border_color=0xff{{ $crust }}

# Register newly installed SF Pro in the existing bar process after reload.
if [[ -r /Library/Fonts/SF-Pro.ttf ]]; then
    sketchybar --load-font /Library/Fonts/SF-Pro.ttf
fi

default=(
	padding_left=5
	padding_right=5
	icon.font="SF Pro:Semibold:15.0"
	label.font="SF Pro:Semibold:15.0"
	icon.color=0xff{{ $subtext1 }}
	label.color=0xff{{ $text }}
	icon.padding_left=6
	icon.padding_right=3
	label.padding_left=3
	label.padding_right=6
	background.color=0xff{{ $surface0 }}
	background.border_color=0xff{{ $surface1 }}
	background.border_width=1
	background.corner_radius=7
	background.height=26
)
sketchybar --default "${default[@]}"

sketchybar --add event hyprspace_workspace_change
sketchybar --add event input_source_changed com.apple.Carbon.TISNotifySelectedKeyboardInputSourceChanged

for sid in {1..9}; do
	space=(
		icon="$sid"
		icon.font="SF Pro:Semibold:15.0"
		label.drawing=on
		label="—"
		label.font="sketchybar-app-font:Regular:20.0"
		label.y_offset=-1
		icon.padding_right=9
		background.color=0xff{{ $lavender }}
		background.border_color=0xff{{ $lavender }}
		icon.highlight_color=0xff{{ $base }}
		label.highlight_color=0xff{{ $base }}
		script="$PLUGIN_DIR/hyprspace_workspace.sh"
		click_script="$HYPRSPACE_BIN workspace $sid"
	)
	sketchybar --add item space."$sid" left \
		--set space."$sid" "${space[@]}" \
		--subscribe space."$sid" hyprspace_workspace_change
done

focused="$("$HYPRSPACE_BIN" list-workspaces --focused 2>/dev/null || true)"
if [ -n "$focused" ]; then
    sketchybar --trigger hyprspace_workspace_change FOCUSED_WORKSPACE="$focused"
fi

# One query updates all nine Hyprspace workspaces, including window moves.
sketchybar --add item space_separator left \
    --set space_separator icon=􀆊 icon.color=0xff{{ $lavender }} \
        label.drawing=off background.drawing=off update_freq=2 \
        script="$PLUGIN_DIR/workspace_apps.js" \
    --subscribe space_separator hyprspace_workspace_change space_windows_change front_app_switched system_woke

sketchybar --add item front_app left \
	--set front_app icon.drawing=off label.padding_left=6 script="$PLUGIN_DIR/front_app.sh" \
	--subscribe front_app front_app_switched

# Omarchy's center anchor maps to SketchyBar's center section. Native launchers
# deliberately replace Quickshell's Linux-only panels and backends.
status_icon=(icon.color=0xff{{ $surface0 }} icon.background.drawing=on icon.background.color=0xff{{ $subtext1 }} icon.padding_right=7 icon.background.height=22 icon.background.y_offset=-1 icon.background.corner_radius=5 icon.background.padding_left=2 icon.background.padding_right=2)
clock=(update_freq=30 icon=􀧞 script="$PLUGIN_DIR/clock.sh" click_script="open -a Calendar" "${status_icon[@]}")
keyboard=(update_freq=5 icon=􀺑 script="$PLUGIN_DIR/keyboard_layout.sh" click_script="open 'x-apple.systempreferences:com.apple.Keyboard-Settings.extension'" "${status_icon[@]}")
weather=(update_freq=900 icon=􀇕 label="N/A" script="$PLUGIN_DIR/weather.sh" click_script="open -a Weather" "${status_icon[@]}")
updates=(update_freq=3600 icon=􀄩 script="$PLUGIN_DIR/brew_updates.sh" "${status_icon[@]}")

sketchybar \
	--add item keyboard center --set keyboard "${keyboard[@]}" \
	--add item weather center --set weather "${weather[@]}" \
	--add item clock center --set clock "${clock[@]}" \
	--add item updates center --set updates "${updates[@]}" \
	--subscribe clock system_woke \
	--subscribe keyboard input_source_changed system_woke \
	--subscribe weather system_woke

percent_label=(label.width=48 label.align=right)
audio=("${percent_label[@]}" update_freq=2 icon=􀊩 script="$PLUGIN_DIR/audio.sh" click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" "${status_icon[@]}")
network=(update_freq=30 icon=􀙇 script="$PLUGIN_DIR/native_status.sh wifi" click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" "${status_icon[@]}")
vpn=(update_freq=30 icon=􀉣 script="$PLUGIN_DIR/native_status.sh vpn" click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'" "${status_icon[@]}")
display=(update_freq=2 updates=on drawing=off script="$PLUGIN_DIR/displays.sh" "${status_icon[@]}")
cpu=("${percent_label[@]}" update_freq=1 icon=􀧓 script="$PLUGIN_DIR/system_metrics.sh" "${status_icon[@]}")
gpu=("${percent_label[@]}" icon=􀐟 label="N/A" "${status_icon[@]}")
memory=("${percent_label[@]}" icon=􀧖 label="N/A" "${status_icon[@]}")
battery=("${percent_label[@]}" update_freq=120 script="$PLUGIN_DIR/battery.sh" click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" "${status_icon[@]}")

sketchybar \
	--add item vpn right --set vpn "${vpn[@]}" \
	--add item network right --set network "${network[@]}" \
	--add item audio right --set audio "${audio[@]}" \
	--add item battery right --set battery "${battery[@]}" \
	--add item display right --set display "${display[@]}" \
	--add item memory right --set memory "${memory[@]}" \
	--add item gpu right --set gpu "${gpu[@]}" \
	--add item cpu right --set cpu "${cpu[@]}" \
	--subscribe audio volume_change system_woke \
	--subscribe network wifi_change system_woke \
	--subscribe vpn system_woke \
	--subscribe display display_change space_change front_app_switched system_woke \
	--subscribe battery system_woke power_source_change

# Keep upstream rendering; its bootstrap exports an invalid registry-loaded flag.
quota_plugin="${XDG_DATA_HOME:-$HOME/.local/share}/showy-quota/adapters/sketchybar/plugins/showy_quota.sh"
if [ -x "$quota_plugin" ]; then
    sketchybar --add event showy_quota_refresh \
        --add item showy_quota.trigger center \
        --set showy_quota.trigger drawing=off updates=on update_freq=10 script="$PLUGIN_DIR/quota_update.js" \
        --subscribe showy_quota.trigger showy_quota_refresh
    if ! "$PLUGIN_DIR/quota_update.js"; then
        echo "SketchyBar: quota update failed; remaining items will still load" >&2
    fi
fi

sketchybar --update

# Restart the optional helper on reload; keep only this user's instance.
if command -v sketchybar-toggle >/dev/null 2>&1; then
	pkill -u "$(id -u)" -x sketchybar-toggle || true
	sketchybar-toggle --trigger-zone 3 --menu-bar-height 50 --debounce 150 &
fi
