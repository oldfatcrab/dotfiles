{{- $palette := include "../themes/catppuccin-contrast.toml" | fromToml -}}
{{- $colors := index $palette "colors" -}}
{{- $active := index $colors "lavender" | trimPrefix "#" -}}
{{- $inactive := index $colors "surface1" | trimPrefix "#" -}}
#!/usr/bin/env bash
set -euo pipefail

# Keep Lavender focus; use darker Surface1 for inactive windows.
options=(
  style=round
  width=12.0
  hidpi=off
  active_color=0xff{{ $active }}
  inactive_color=0xff{{ $inactive }}
)

borders "${options[@]}"
