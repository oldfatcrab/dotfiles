{{- $palette := include "../themes/catppuccin-contrast.toml" | fromToml -}}
{{- $colors := index $palette "colors" -}}
{{- $subtext1 := index $colors "subtext1" | trimPrefix "#" -}}
{{- $surface0 := index $colors "surface0" | trimPrefix "#" -}}
{{- $yellow := index $colors "yellow" | trimPrefix "#" -}}
{{- $red := index $colors "red" | trimPrefix "#" -}}
#!/usr/bin/env bash
set -euo pipefail

snapshot=$(pmset -g batt)
PERCENTAGE=$(printf '%s\n' "$snapshot" | grep -o '[0-9]\+%' | head -1 | cut -d% -f1 || true)

if [[ -z "$PERCENTAGE" ]]; then
    sketchybar --set "$NAME" icon=􀡸 label="AC 􀋦" icon.color=0xff{{ $surface0 }} icon.background.color=0xff{{ $subtext1 }}
    exit 0
fi

case ${PERCENTAGE} in
[1-2][0-9]) ICON_BG_COLOR="0xff{{ $yellow }}" ;;
[0-9]) ICON_BG_COLOR="0xff{{ $red }}" ;;
*) ICON_BG_COLOR="0xff{{ $subtext1 }}" ;;
esac

ICON="􁠸"
if [[ "$snapshot" == *"AC Power"* ]]; then ICON="􀫯"; fi

sketchybar --set "$NAME" icon="$ICON" icon.color=0xff{{ $surface0 }} icon.background.color="$ICON_BG_COLOR" label="${PERCENTAGE}%"
