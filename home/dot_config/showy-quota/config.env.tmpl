{{- $colors := (include "../themes/catppuccin-contrast.toml" | fromToml).colors -}}
# Managed by chezmoi. Provider authentication remains in CodexBar.
SHOWY_QUOTA_THEME=catppuccin-contrast
SHOWY_QUOTA_PROVIDERS=codex
SHOWY_QUOTA_SKETCHYBAR_CLICK="open -b com.openai.codex"
SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_MODE=font
SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_FONT=sketchybar-app-font:Regular:18.0
SHOWY_QUOTA_SKETCHYBAR_ICON_WIDTH=31
SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_FONT_PADDING_RIGHT=7
SHOWY_QUOTA_SKETCHYBAR_ICON_PADDING_LEFT=0
SHOWY_QUOTA_SKETCHYBAR_ICON_BG_COLOR=0xff{{ $colors.subtext1 | trimPrefix "#" }}
SHOWY_QUOTA_SKETCHYBAR_ICON_FG_COLOR=0xff{{ $colors.surface0 | trimPrefix "#" }}
SHOWY_QUOTA_SKETCHYBAR_PILL_HEIGHT=26
SHOWY_QUOTA_SKETCHYBAR_PILL_RADIUS=7
SHOWY_QUOTA_SKETCHYBAR_PILL_COLOR=0xff{{ $colors.surface0 | trimPrefix "#" }}
