{{- $palette := include "../themes/catppuccin-contrast.toml" | fromToml -}}
{{- $colors := index $palette "colors" -}}
{{- $ui := index $palette "ui" -}}
{{- $terminal := index $palette "terminal" -}}
{
  "name": "Cappuccin Contrast",
  "appearance": "dark",
  "canvas": "{{ index $colors (index $ui "background") }}",
  "accent": "{{ index $colors "mauve" }}",
  "colors": {
    "chrome": "{{ index $colors (index $ui "background_secondary") }}",
    "toolbar": "{{ index $colors (index $ui "background_secondary") }}",
    "toolbarForeground": "{{ index $colors (index $ui "text") }}",
    "toolbarBorder": "{{ index $colors "surface1" }}",
    "toolbarControl": "{{ index $colors (index $ui "surface") }}",
    "toolbarControlForeground": "{{ index $colors (index $ui "text") }}",
    "toolbarControlHover": "{{ index $colors (index $ui "surface_hover") }}",
    "surface": "{{ index $colors (index $ui "background") }}",
    "surfaceRaised": "{{ index $colors (index $ui "surface") }}",
    "surfaceOverlay": "{{ index $colors (index $ui "surface_hover") }}",
    "text": "{{ index $colors (index $ui "text") }}",
    "textMuted": "{{ index $colors (index $ui "text_muted") }}",
    "border": "{{ index $colors "surface1" }}",
    "input": "{{ index $colors (index $ui "surface") }}",
    "focus": "{{ index $colors "mauve" }}",
    "accentForeground": "{{ index $colors (index $ui "text_on_accent") }}",
    "secondary": "{{ index $colors (index $ui "surface") }}",
    "secondaryForeground": "{{ index $colors (index $ui "text") }}",
    "muted": "{{ index $colors (index $ui "background_secondary") }}",
    "mutedForeground": "{{ index $colors (index $ui "text_muted") }}",
    "placeholder": "{{ index $colors (index $ui "overlay_emphasis") }}",
    "secondaryLabel": "{{ index $colors (index $ui "text_muted") }}",
    "iconMuted": "{{ index $colors (index $ui "text_subtle") }}",
    "error": "{{ index $colors (index $ui "error") }}",
    "errorForeground": "{{ index $colors "maroon" }}",
    "errorSurface": "{{ index $colors (index $ui "surface") }}",
    "warning": "{{ index $colors (index $ui "warning") }}",
    "warningForeground": "{{ index $colors "peach" }}",
    "warningSurface": "{{ index $colors (index $ui "surface") }}",
    "update": "{{ index $colors (index $ui "information") }}",
    "updateForeground": "{{ index $colors "sky" }}",
    "updateSurface": "{{ index $colors (index $ui "surface") }}",
    "accentSurface": "{{ index $colors (index $ui "surface") }}",
    "accentSurfaceForeground": "{{ index $colors (index $ui "text") }}",
    "messageSurface": "{{ index $colors (index $ui "surface") }}",
    "messageForeground": "{{ index $colors (index $ui "text") }}",
    "messageAction": "{{ index $colors "lavender" }}",
    "messageActionForeground": "{{ index $colors (index $ui "text_on_accent") }}",
    "messageActionHover": "{{ index $colors "pink" }}",
    "codeBackground": "{{ index $colors (index $ui "background_secondary") }}",
    "codeForeground": "{{ index $colors (index $ui "text") }}",
    "searchMatchBackground": "{{ index $colors "teal" }}",
    "searchMatchForeground": "{{ index $colors "crust" }}",
    "searchMatchActiveBackground": "{{ index $colors "yellow" }}",
    "searchMatchActiveForeground": "{{ index $colors "crust" }}",
    "sidebar": "{{ index $colors (index $ui "background_secondary") }}",
    "sidebarForeground": "{{ index $colors (index $ui "text") }}",
    "sidebarMutedForeground": "{{ index $colors (index $ui "text_muted") }}",
    "sidebarControlSurface": "{{ index $colors (index $ui "surface") }}",
    "sidebarRowHover": "{{ index $colors (index $ui "surface") }}",
    "sidebarRowActive": "{{ index $colors (index $ui "surface_hover") }}",
    "sidebarRowSelected": "{{ index $colors (index $ui "surface_active") }}",
    "sidebarBorder": "{{ index $colors "surface1" }}",
    "terminalBackground": "{{ index $colors (index $terminal "background") }}",
    "terminalForeground": "{{ index $colors (index $terminal "foreground") }}",
    "terminalCursor": "{{ index $colors (index $terminal "cursor") }}",
    "terminalSelection": "{{ index $colors (index $ui "selection_background") }}",
    "terminalScrollbar": "{{ index $colors "overlay0" }}",
    "terminalScrollbarHover": "{{ index $colors "overlay1" }}"
  }
}
