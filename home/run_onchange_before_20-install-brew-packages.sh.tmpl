#!/usr/bin/env bash

# Re-run only when the public base manifest changes.
# {{ include "../Brewfiles/Brewfile.base" | sha256sum }}

set -euo pipefail

echo "==> [Homebrew Bundle] Brewfile change detected. Syncing dependencies..."

# -----------------------------------------------------------------------------
# Environment Initialization
# Load Homebrew into PATH for macOS (Apple Silicon / Intel).
# -----------------------------------------------------------------------------
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v brew &>/dev/null; then
    echo "--> [Error] Homebrew binary not found. Skipping bundle execution."
    exit 1
fi

# The private workstation bootstrap owns its separate personal Brewfile.
CHEZMOI_SOURCE_DIR="{{ .chezmoi.sourceDir }}"
BREWFILE="${CHEZMOI_SOURCE_DIR}/../Brewfiles/Brewfile.base"
if [[ ! -f "$BREWFILE" ]]; then
    echo "--> [Error] Missing public Brewfile: $BREWFILE" >&2
    exit 1
fi
brew bundle --file="$BREWFILE"

{{ if eq .chezmoi.os "darwin" }}
if brew list --formula openjdk &>/dev/null; then
    jdk_bundle="$(brew --prefix openjdk)/libexec/openjdk.jdk"
    jdk_link="/Library/Java/JavaVirtualMachines/openjdk.jdk"

    if [[ -e "${jdk_link}" && ! -L "${jdk_link}" ]]; then
        echo "--> [Error] ${jdk_link} exists and is not a symlink."
        exit 1
    fi
    if [[ "$(readlink "${jdk_link}" 2>/dev/null || true)" != "${jdk_bundle}" ]]; then
        echo "--> Registering Homebrew OpenJDK with macOS..."
        sudo ln -sfn "${jdk_bundle}" "${jdk_link}"
    fi
fi
{{ end }}

echo "==> [Homebrew Bundle] All target Brewfiles applied successfully."
