# Omarchy-inspired shell-tool baseline. Intentionally excludes tldr; see
# DECISIONS.md for the documentation-tooling decision.
tap "bjarneo/cliamp"
tap "can1357/tap"
tap "charmbracelet/tap"
tap "FelixKratz/formulae"
tap "hashicorp/tap"
tap "PeachlifeAB/tap"
brew "bat"
brew "bat-extras"
brew "bjarneo/cliamp/cliamp", trusted: true
brew "FelixKratz/formulae/borders", trusted: true
brew "can1357/tap/omp", trusted: true
brew "chafa"
brew "charmbracelet/tap/crush", trusted: true
brew "docker"
brew "docker-agent"
brew "dua-cli"
brew "eza"
brew "fd"
brew "fzf"
# brew "fzf-tab"
brew "carapace"
brew "git-delta"
brew "gh"
brew "btop"
brew "fastfetch"
brew "ffmpeg-full"
brew "herdr"
brew "imagemagick"
brew "lazydocker"
brew "lazygit"
brew "mas"
brew "maven"
brew "mpv"
brew "neovim"
brew "node"
brew "openjdk"
brew "opencode"
brew "pi-coding-agent"
brew "powerlevel10k"
brew "ripgrep"
brew "FelixKratz/formulae/sketchybar", trusted: true
brew "try"
brew "tmux"
brew "tailscale"
brew "hashicorp/tap/terraform", trusted: true
brew "terraform-ls"
brew "uv"
brew "yt-dlp"
brew "yazi"
brew "yaml-language-server"
brew "zinit"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-vi-mode"
brew "vivid"
cask "1password"
cask "1password-cli"
cask "antigravity"
cask "antigravity-cli"
cask "basictex"
cask "claude"
cask "claude-code"
cask "copilot-cli"
cask "docker-desktop"
cask "dropbox"
cask "grok-bot"
cask "grok-build"
cask "ghostty"
cask "PeachlifeAB/tap/hyprspace", trusted: true
cask "kdenlive"
cask "obs"
cask "obsidian"
cask "raycast"
cask "signal"
cask "spotify"
cask "surfshark"
cask "tailscale-app"
cask "chatgpt"
cask "discord"
cask "whatsapp"
cask "visual-studio-code"
cask "zoom"
cask "font-jetbrains-mono-nerd-font"
cask "font-caskaydia-mono-nerd-font"
cask "font-meslo-lg-nerd-font"
cask "font-fira-code-nerd-font"
