# =============================================================================
# ~/.zshrc — Interactive Shell Configuration
#
# Architecture:
#   1. Powerlevel10k Instant Prompt (must be first — no console output above)
#   2. Zinit Plugin Manager Bootstrap
#   3. Powerlevel10k Theme (loaded synchronously for instant rendering)
#   4. Modular Config Sourcing (~/.config/zsh/{env,aliases,functions,init}.zsh)
#   5. Zinit Plugins (OMZ snippets + turbo-loaded advanced plugins)
#   6. Completion Engine & FZF-Tab Configuration
#   7. Powerlevel10k Config & Optional Banner
#
# Convention (https://www.freecodecamp.org/news/how-do-zsh-configuration-files-work/):
#   ~/.zprofile  → PATH, brew shellenv (login shells only)
#   ~/.zshrc     → everything interactive (this file)
# =============================================================================

# =============================================================================
# 0. Startup Banner (fastfetch)
# Must run before p10k instant prompt so console output does not trigger warnings
# or interfere with instant prompt rendering.
# =============================================================================
if command -v fastfetch &>/dev/null; then
    fastfetch
    echo
elif [[ -x "/opt/homebrew/bin/fastfetch" ]]; then
    /opt/homebrew/bin/fastfetch
    echo
elif [[ -x "/usr/local/bin/fastfetch" ]]; then
    /usr/local/bin/fastfetch
    echo
fi

# =============================================================================
# 1. Powerlevel10k Instant Prompt
# Must remain above all other zshrc configs (except banner output above).
# =============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# 2. Zinit Plugin Manager Bootstrap
# Attempts to load zinit from Homebrew first, then falls back to the
# self-installing GitHub clone method.
# =============================================================================
{{ if eq .chezmoi.arch "arm64" -}}
ZINIT_BREW_PATH="/opt/homebrew/opt/zinit/zinit.zsh"
{{ else -}}
ZINIT_BREW_PATH="/usr/local/opt/zinit/zinit.zsh"
{{ end -}}

if [[ -f "$ZINIT_BREW_PATH" ]]; then
    source "$ZINIT_BREW_PATH"
elif [[ -f "${HOME}/.local/share/zinit/zinit.git/zinit.zsh" ]]; then
    source "${HOME}/.local/share/zinit/zinit.git/zinit.zsh"
else
    # Self-install zinit from GitHub
    ZINIT_HOME="${HOME}/.local/share/zinit/zinit.git"
    mkdir -p "$(dirname "$ZINIT_HOME")"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" 2>/dev/null
    source "${ZINIT_HOME}/zinit.zsh"
fi

# =============================================================================
# 3. Powerlevel10k Theme (synchronous load for instant prompt)
# =============================================================================
zinit ice depth"1"
zinit light romkatv/powerlevel10k

# =============================================================================
# 4. Source Modular Configuration
# Order matters: env → aliases → functions → init
# =============================================================================
for config_file in \
    "${HOME}/.config/zsh/env.zsh" \
    "${HOME}/.config/zsh/aliases.zsh" \
    "${HOME}/.config/zsh/functions.zsh" \
    "${HOME}/.config/zsh/init.zsh"; do
    [[ -r "$config_file" ]] && source "$config_file"
done
unset config_file

# =============================================================================
# 5. Zinit Plugins
# =============================================================================

# ---------------------------------------------------------------------------
# 5a. Oh-My-Zsh Snippets (Turbo Mode — deferred loading)
# ---------------------------------------------------------------------------
zinit wait lucid for \
    OMZP::git \
    OMZP::sudo \
    OMZP::extract \
    OMZP::copypath \
    OMZP::copyfile

# ---------------------------------------------------------------------------
# 5b. Advanced Plugins (Turbo Mode — deferred loading)
# ---------------------------------------------------------------------------

# eza: Oh-My-Zsh plugin for eza aliases
zinit wait lucid for \
    OMZP::eza

# You-Should-Use: Reminds you of existing aliases
zinit wait lucid for \
    MichaelAquilina/zsh-you-should-use

# Core Completion and Interactive Plugins
# Must be loaded in strict order: completions -> fzf-tab -> autosuggestions -> syntax-highlighting
zinit wait lucid blockf for \
    atinit"zicompinit; zicdreplay; compdef _cd zd" \
    zsh-users/zsh-completions \
    Aloxaf/fzf-tab \
    atload"_zsh_autosuggest_start" \
    zsh-users/zsh-autosuggestions \
    zsh-users/zsh-syntax-highlighting

# =============================================================================
# 6. Completion Engine & FZF-Tab Configuration
# =============================================================================

# fzf-tab-completion (lincheney): enable display string search
zstyle ':completion:*' fzf-search-display true

# OMZ Plugin Configurations
zstyle ':omz:plugins:eza' 'git-status' yes
zstyle ':omz:plugins:eza' 'header' yes
zstyle ':omz:plugins:eza' 'icons' yes
zstyle ':omz:plugins:eza' 'hyperlink' yes

# Native Completion Formatting & Styles
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# Force cd/zd to only complete directories (filters out files in fzf-tab)
zstyle ':completion:*:*:(cd|zd):*' tag-order local-directories directory-stack path-directories

# FZF-Tab Global Flags & UI Bindings
# Disable default description to focus on the preview window
zstyle ':fzf-tab:*' show-group no
zstyle ':fzf-tab:*' single-group ''

# Layout: right side 60% with left border
zstyle ':fzf-tab:*' fzf-flags '--preview-window=right:60%:border-left'

# Bind tab to continuous completion (allows entering directories)
zstyle ':fzf-tab:*' continuous-trigger 'tab'
zstyle ':fzf-tab:*' fzf-bindings 'space:accept' 'btab:ignore'

# Use a custom fzf command wrapper to clear images when fzf-tab exits
zstyle ':fzf-tab:*' fzf-command ftb_fzf_with_kitty_clear

# FZF-Tab Process & Service Previews
zstyle ':completion:*:*:*:*:processes' command "ps -u $USER -o pid,user,comm -w -w"
zstyle ':fzf-tab:complete:(kill|ps):argument-rest' fzf-preview \
    '[[ $group == "[process ID]" ]] && ps -p $word -o command -w | tail -n +2'
zstyle ':fzf-tab:complete:(kill|ps):argument-rest' fzf-flags --preview-window=down:3:wrap
zstyle ':fzf-tab:complete:alias:*' fzf-preview 'alias $word 2>/dev/null'

# FZF-Tab Universal File & Syntax Inspector Preview (Yazi style)
zstyle ':fzf-tab:complete:*:*' fzf-preview '
  exec 2>/dev/null
  printf "\e_Ga=d\e\\" # Clear previous kitty images
  mime=$(file -b --mime-type $realpath)
  if [[ $mime =~ ^image/ ]]; then
    chafa -f kitty --size=$((FZF_PREVIEW_COLUMNS * 9 / 10))x$((FZF_PREVIEW_LINES * 9 / 10)) $realpath
  elif [[ $mime =~ ^video/ && -x "$(command -v ffmpeg)" ]]; then
    ffmpeg -y -i $realpath -vf thumbnail -frames:v 1 -f image2pipe -vcodec png /tmp/fzf_preview_vid.png
    chafa -f kitty --size=$((FZF_PREVIEW_COLUMNS * 9 / 10))x$((FZF_PREVIEW_LINES * 9 / 10)) /tmp/fzf_preview_vid.png
  elif [[ $mime =~ ^application/pdf && -x "$(command -v pdftoppm)" ]]; then
    pdftoppm -png -f 1 -singlefile $realpath /tmp/fzf_preview_pdf
    chafa -f kitty --size=$((FZF_PREVIEW_COLUMNS * 9 / 10))x$((FZF_PREVIEW_LINES * 9 / 10)) /tmp/fzf_preview_pdf.png
  elif [[ -d $realpath ]]; then
    eza -T -L 2 --color=always --icons=always $realpath
  elif [[ -f $realpath ]]; then
    bat --color=always --style=numbers,changes,header --line-range :100 $realpath
  elif [[ -b $realpath || -c $realpath || -p $realpath ]]; then
    file -b $realpath
  else
    echo $word
  fi
'

# Command specific previews
zstyle ':fzf-tab:complete:(cd|z|zi):*' fzf-preview 'eza -T -L 2 --color=always --icons=always $realpath'
zstyle ':fzf-tab:complete:(-command-|-parameter-|-brace-parameter-|export|unset|expand):*' fzf-preview 'echo ${(P)word}'

# =============================================================================
# 7. Powerlevel10k Config & Optional Banner
# =============================================================================

# Load Powerlevel10k user configuration
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
