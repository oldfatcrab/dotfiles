#!/usr/bin/env python3
"""Apply portable T3 appearance fields without replacing private runtime settings."""
import json
import os
from pathlib import Path
import shutil
import stat
import sys
import tempfile

POLICY = Path.home() / ".config/t3-code/appearance.json"
STATE = Path.home() / ".t3/userdata/client-settings.json"
BACKUP = Path.home() / ".t3/userdata/client-settings.pre-bicerin.json"
ALLOWED = {
    "appearanceContrast", "chatWidth", "glassOpacity",
    "panelAnimationDurationMs", "fontFamilySans", "fontFamilyComposer",
    "fontFamilyCode", "fontFamilyTerminal", "fontSizeInterface",
    "fontSizePrompt", "fontSizeCode", "fontSizeTerminal",
    "fontSmoothing", "diffColorScheme", "diffLayout",
    "diffFilesCollapsed", "diffIgnoreWhitespace", "wordWrap",
    "boringSidebarEnabled", "boringSidebarMultilineRows",
    "sidebarWorkingShelfEnabled", "sidebarProjectGroupingMode",
    "sidebarProjectSortOrder", "sidebarThreadSortOrder",
    "timestampFormat", "effortDisplay",
}

def main() -> int:
    if sys.platform != "darwin":
        print("T3 appearance: macOS only; skipped.")
        return 0
    if not POLICY.is_file():
        print("T3 appearance: policy not installed; skipped.")
        return 0
    if not STATE.is_file():
        print("T3 appearance: T3 has not created client-settings.json; skipped.")
        return 0
    if STATE.is_symlink():
        raise RuntimeError("Refusing to replace symlinked T3 runtime settings.")
    desired = json.loads(POLICY.read_text())
    if not isinstance(desired, dict) or set(desired) != ALLOWED:
        raise ValueError("Appearance policy keys differ from the approved allowlist.")
    current = json.loads(STATE.read_text())
    if not isinstance(current, dict):
        raise ValueError("T3 client-settings.json is not an object.")
    for key, value in desired.items():
        if key in current and type(current[key]) is not type(value):
            raise TypeError(f"Unexpected T3 setting type for {key}")
    changed = [key for key, value in desired.items() if current.get(key) != value]
    if not changed:
        print("T3 appearance: already matches Bicerin policy.")
        return 0
    if not BACKUP.exists():
        with BACKUP.open("xb") as out:
            os.chmod(BACKUP, 0o600)
            with STATE.open("rb") as source:
                shutil.copyfileobj(source, out)
    current.update(desired)
    mode = stat.S_IMODE(STATE.stat().st_mode)
    fd, temporary = tempfile.mkstemp(prefix=".t3-client-settings.", dir=STATE.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(current, output, ensure_ascii=False, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, STATE)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"T3 appearance: applied {len(changed)} visual settings; unrelated settings preserved.")
    print("T3 appearance: restart the application if the current window has cached fonts.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
