# -----------------------------------------------------------------------------
# Interactive Prompts during `chezmoi init`
# -----------------------------------------------------------------------------

{{ $is_personal := promptBoolOnce . "is_personal_machine" "Is this a personal machine" -}}

[data]
    is_personal_machine = {{ $is_personal }}

# Hide actionable script entries from inspection, without disabling apply.
[diff]
    exclude = ["scripts"]

[status]
    exclude = ["scripts"]
